{
  "name": "@parthobepary/nuxt-meta-pixel",
  "version": "1.0.6",
  "description": "Lightweight Facebook Meta Pixel for Nuxt 3/4 - GDPR consent, advanced matching, cookie validation, CAPI support",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Partho",
    "url": "https://github.com/parthobepary"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthobepary/facebook-pixel.git"
  },
  "homepage": "https://github.com/parthobepary/facebook-pixel#readme",
  "bugs": {
    "url": "https://github.com/parthobepary/facebook-pixel/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "release": "yarn prepack && yarn publish"
  },
  "dependencies": {
    "@nuxt/kit": "^3.12.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^1.3.0",
    "@nuxt/eslint-config": "^0.3.0",
    "@nuxt/module-builder": "^0.8.0",
    "@nuxt/schema": "^3.12.0",
    "@nuxt/test-utils": "^3.13.0",
    "eslint": "^9.0.0",
    "nuxt": "^3.12.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "nuxt": "^3.12.0"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "facebook-pixel",
    "meta-pixel",
    "tracking",
    "analytics",
    "facebook",
    "meta",
    "pixel",
    "fbq",
    "conversion",
    "marketing",
    "nuxt3",
    "nuxt4",
    "vue",
    "vuejs",
    "gdpr",
    "consent",
    "capi",
    "conversions-api",
    "event-tracking",
    "advanced-matching",
    "fbclid",
    "retargeting",
    "ads"
  ]
}
